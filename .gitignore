# Git ignore rules for 5Star Predictions
# ──────────────────────────────────────

# Environment / secrets — NEVER commit
.env

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# SQLite database (local dev only)
*.db
*.db-shm
*.db-wal

# Training data (kept locally, not redistributed — see README)
data/

# Legacy synthetic half-time model (never served)
app/ml/models/ht_ou_model.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
