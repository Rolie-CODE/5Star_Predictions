# ──────────────────────────────────────────────────────────────────────────────
# 5Star Predictions — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# "development" or "production"
APP_ENV=development

# Your API-Sports key (from https://api-sports.io → My Account → API Key)
API_SPORTS_KEY=your_api_sports_key_here

# API-Sports base URL (do not change unless API version changes)
API_SPORTS_BASE_URL=https://v1.basketball.api-sports.io

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./5star.db

# Production on Render (PostgreSQL) — set this in Render's environment variables:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── NBA Config ────────────────────────────────────────────────────────────────
# API-Sports league ID for NBA
NBA_LEAGUE_ID=12

# Current NBA season string (update each year)
NBA_SEASON=2025-2026

# ── Predictions ───────────────────────────────────────────────────────────────
# How many top picks to return by default
TOP_PREDICTIONS_LIMIT=5
