# ──────────────────────────────────────────────────────────────────────────────
# 5Star Predictions — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# "development" or "production"
APP_ENV=development

# Secret for admin endpoints (POST /predictions/refresh, header X-API-Key).
# Leave empty to disable them. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Comma-separated browser origins allowed by CORS ("*" = any)
CORS_ORIGINS=*

# Your API-Sports key (from https://api-sports.io → My Account → API Key)
API_SPORTS_KEY=your_api_sports_key_here

# API-Sports base URL (do not change unless API version changes)
API_SPORTS_BASE_URL=https://v1.basketball.api-sports.io

# Client-side request throttle. The Free plan allows 10/min; 0 disables it.
API_SPORTS_MAX_REQUESTS_PER_MINUTE=10

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./5star.db

# Production (PostgreSQL) — a plain postgresql:// URL also works:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── NBA Config ────────────────────────────────────────────────────────────────
# API-Sports league ID for NBA
NBA_LEAGUE_ID=12

# Season string, e.g. 2026-2027. Leave empty to derive it from today's date.
NBA_SEASON=

# Timezone that defines a game day (NBA slates follow US Eastern time)
LEAGUE_TIMEZONE=America/New_York

# ── Predictions ───────────────────────────────────────────────────────────────
# How many top picks to return by default
TOP_PREDICTIONS_LIMIT=5
